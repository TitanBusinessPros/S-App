web/dist/
functions/lib/

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
*.local

# Env / secrets — never commit these
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only source assets and notes — not part of the app. The app icon
# generated from App-Icon.png already lives in web/public/ and is what's
# actually deployed; these are just the raw inputs/scratch files.
/App-Icon.png
/favicon.zip
/How to open app from power shell.txt
/How to give Stripe Webhook Secret in Claude.txt
/10 ideas for survival app.txt

# Disaster-recovery backups — full snapshots of code, GitHub/Firebase/GCP
# config, and IAM policy, generated locally as V-2/, V-3/, etc. Never push
# these: even though they hold no secret values or user data, they hold
# internal infra detail (service specs, IAM bindings, branch protection)
# that has no reason to be public.
/V-[0-9]*/
